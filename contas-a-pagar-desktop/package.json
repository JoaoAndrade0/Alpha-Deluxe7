{
  "name": "contas-a-pagar",
  "productName": "Contas a Pagar",
  "version": "1.0.0",
  "description": "Controle de compras parceladas no cartão, com leitura automática de notas.",
  "author": "Alpha Deluxe 7",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "xvfb-run -a node test/e2e/todos.js",
    "test:cobertura": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "test:smoke": "node test/smoke/empacotado.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "br.com.alphadeluxe7.contasapagar",
    "productName": "Contas a Pagar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders}/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Contas a Pagar",
      "artifactName": "ContasAPagar-Instalador-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "artifactName": "ContasAPagar-${version}-${arch}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": "github:JoaoAndrade0/Alpha-Deluxe7"
}
